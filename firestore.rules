rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the authenticated user has admin role
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'tripambiswas007@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 🌐 MUSICLY PUBLIC LIBRARY
    match /public_tracks/{trackId} {
      allow read: if true;
      allow write: if true;
    }

    // 🎨 ROOM THEMES & SCENES
    match /public_scenes/{sceneId} {
      allow read: if true;
      allow write: if true;
    }

    // 🖼️ STUDIO BACKGROUND VISUALS & LIVE WALLPAPERS
    match /public_scene_visuals/{sceneId} {
      allow read: if true;
      allow write: if true;
    }

    // 🎨 ACTIVE SCENE THEME IMAGE OVERRIDES
    match /public_scene_overrides/{sceneId} {
      allow read: if true;
      allow write: if true;
    }

    // ⚙️ PUBLIC SETTINGS & STUDIO VISUAL GALLERY
    match /public_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // 📜 OFFICIAL MUSICLY PLAYLISTS
    match /public_playlists/{playlistId} {
      allow read: if true;
      allow write: if true;
    }

    // 🎧 REALTIME ACTIVE LISTENERS
    match /active_listeners/{listenerId} {
      allow read: if true;
      allow write: if true;
    }

    // 👤 USER PROFILES
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 🔒 PRIVATE USER CUSTOM TRACKS
    match /users/{userId}/custom_tracks/{trackId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 📻 SONG REQUESTS
    match /song_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // 💬 LISTENER FEEDBACK & RATINGS
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
