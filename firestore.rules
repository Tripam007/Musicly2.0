rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the authenticated user has admin role
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'tripambiswas007@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 🌐 MUSICLY PUBLIC LIBRARY
    match /public_tracks/{trackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🗑️ PERMANENTLY PURGED PUBLIC TRACK TOMBSTONES
    match /public_deleted_tracks/{trackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🎨 ROOM THEMES & SCENES
    match /public_scenes/{sceneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🖼️ STUDIO BACKGROUND VISUALS & LIVE WALLPAPERS
    match /public_scene_visuals/{sceneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🎨 ACTIVE SCENE THEME IMAGE OVERRIDES
    match /public_scene_overrides/{sceneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ⚙️ PUBLIC SETTINGS & STUDIO VISUAL GALLERY
    match /public_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 📜 OFFICIAL MUSICLY PLAYLISTS
    match /public_playlists/{playlistId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🎧 REALTIME ACTIVE LISTENERS
    match /active_listeners/{listenerId} {
      allow read: if true;
      allow write: if true;
    }

    // 👤 USER PROFILES (Protected from IDOR and Privilege Escalation)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId && 
                    (!('role' in request.resource.data) || request.resource.data.role != 'admin' || request.auth.token.email == 'tripambiswas007@gmail.com');
      allow update: if request.auth != null && (
        isAdmin() || 
        (request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
      );
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // 🔒 PRIVATE USER CUSTOM TRACKS & PLAYLISTS
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // 📻 SONG REQUESTS
    match /song_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // 💬 LISTENER FEEDBACK & RATINGS
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
